generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id        String   @id @default("default")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model HomeContent {
  id        String   @id @default("default")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model Client {
  id             String   @id
  name           String
  initials       String
  niche          String
  whatsapp       String
  email          String?
  instagram      String?
  empresa        String?
  status         String
  totalValue     Float    @default(0)
  lastProject    String
  origem         String
  notes          Json
  services       Json
  history        Json
  invoices       Json
  monthlyRevenue Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Project {
  id            String   @id
  clientId      String
  clientName    String
  title         String
  serviceType   String
  dueDate       String
  priority      String
  value         Float    @default(0)
  status        String
  checklist     Json
  comments      Json
  description   String   @default("")
  startDate     String   @default("")
  location      String   @default("")
  coverImageUrl String?
  images        Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CalendarEvent {
  id         String   @id
  title      String
  type       String
  clientName String?
  date       String
  startTime  String
  endTime    String
  location   String
  value      Float?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GlobalNote {
  id        String   @id
  title     String?
  category  String
  content   String
  color     String
  pinned    Boolean  @default(false)
  createdAt String
  checklist Json?
  dbCreated DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Expense {
  id          String   @id
  description String
  category    String   @default("GERAL")
  date        String
  value       Float    @default(0)
  status      String   @default("PAGO")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PortfolioItem {
  id          String   @id
  title       String
  slug        String   @default("")
  category    String
  imageKey    String   @default("")
  imageUrl    String?
  isVideo     Boolean  @default(false)
  sortOrder   Int      @default(0)
  description String   @default("")
  images      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id
  name      String
  niche     String   @default("")
  quote     String
  instagram String?
  imageKey  String   @default("")
  imageUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}