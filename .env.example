# Neon/Postgres connection string used by Prisma
DATABASE_URL=

# admin login (used by /admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# secret used to sign admin session cookies (any long random string)
AUTH_SECRET=

# URL pública do site (usada em canonical, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=

# Configurações do AWS S3 / S3-Compatible (Cloudflare R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_S3_BUCKET=

# Endpoint S3-Compatible (R2). IMPORTANTE: só o origin, SEM o bucket no fim.
# Ex R2: https://<account-id>.r2.cloudflarestorage.com
# Para AWS S3 padrão, deixe vazio.
AWS_ENDPOINT=

# URL pública base para servir arquivos (ex R2: https://pub-xxx.r2.dev)
AWS_S3_PUBLIC_URL=
